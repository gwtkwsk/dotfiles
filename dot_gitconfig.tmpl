[user]
	email = {{ (bitwardenFields "item" "dotfiles GitHub user").email.value }}
	name = {{ (bitwardenFields "item" "dotfiles GitHub user").name.value }}

[alias]
	last = log -1 --stat
	cp = cherry-pick
	co = checkout
	cl = clone
	ci = commit
	st = status -sb
	br = branch
	ft = fetch -p
	unstage = reset HEAD --
	dc = diff --cached
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %Cblue<%an>%Creset' --abbrev-commit --date=relative --all
	cln = clean -xdn
	cli = clean -xdi
	clf = clean -xdf
	cls = clean -xdf -e .idea/ -e .gradle/

[color]
	ui = true

[merge]
	ff = only
	conflictstyle = diff3

[push]
	default = simple
[core]
	autocrlf = input

[status]
	showUntrackedFiles = all

[init]
	defaultBranch = main

[url "git@github.com:"]
  insteadOf = https://github.com/

