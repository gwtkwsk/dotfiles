{{- $promptEngine := "powerlevel10k" -}}
{{- if hasKey . "prompt_engine" -}}
  {{- if or (eq .prompt_engine "starship") (eq .prompt_engine "powerlevel10k") (eq .prompt_engine "none") -}}
    {{- $promptEngine = .prompt_engine -}}
  {{- else -}}
    {{- fail (printf "Unsupported .prompt_engine value %q in .chezmoidata.yaml" .prompt_engine) -}}
  {{- end -}}
{{- end -}}

export ZSH_CUSTOM="$HOME/.zshrc.d"

# Set to `starship`, `powerlevel10k`, or `none`.
export ZSH_PROMPT_ENGINE="${ZSH_PROMPT_ENGINE:-{{ $promptEngine }}}"

# >>> PROMPT
# Oh My Zsh reads ZSH_THEME during startup, so this must stay above `source $ZSH/oh-my-zsh.sh`.
case "$ZSH_PROMPT_ENGINE" in
  powerlevel10k)
    if [[ -d "$ZSH_CUSTOM/themes/powerlevel10k" ]]; then
      ZSH_THEME="powerlevel10k/powerlevel10k"
    else
      ZSH_THEME="robbyrussell"
    fi
    ;;
  starship)
    ZSH_THEME=""
    ;;
  none)
    ZSH_THEME="robbyrussell"
    ;;
  *)
    ZSH_THEME="robbyrussell"
    ;;
esac
# <<< PROMPT

# >>> OH-MY-ZSH
# Keep Oh My Zsh for plugin loading (`plugins=(git)`) and auto-loading files from `$ZSH_CUSTOM`.
export ZSH="$HOME/.oh-my-zsh"
plugins=(git)
source $ZSH/oh-my-zsh.sh
# <<< OH-MY-ZSH

# >>> EDITOR
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vi'
else
  export EDITOR='nvim'
fi
# <<< EDITOR

# >>> NODE
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
# <<< NODE

# >>> LM STUDIO
export PATH="$PATH:$HOME/.lmstudio/bin"
# <<< LM STUDIO

# >>> PATH
export PATH="$PATH:$HOME/.local/bin:$HOME/bin:$HOME/.cargo/bin:$HOME/.opencode/bin"
# <<< PATH

# >>> SSH
for ssh_key in \
  "$HOME/.ssh/id_github_gwtkwsk_ed25519" \
  "$HOME/.ssh/id_github_grzegorzwitkowski_ed25519"; do
  [[ -f "$ssh_key" ]] && ssh-add "$ssh_key" 2>/dev/null
done
# <<< SSH

# >>> PROMPT
case "$ZSH_PROMPT_ENGINE" in
  starship)
    if command -v starship >/dev/null 2>&1; then
      eval "$(starship init zsh)"
    fi
    ;;
  powerlevel10k)
    [[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
    ;;
esac
# <<< PROMPT

# >>> LANG
export LANG=en_GB.UTF-8
# <<< LANG

# >>> ZOXIDE
eval "$(zoxide init zsh)"
# <<< ZOXIDE

# >>> WORKTRUNK
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
# <<< WORKTRUNK
