
# >>> OH-MY-ZSH
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh
# <<< OH-MY-ZSH

# >>> EDITOR
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vi'
else
  export EDITOR='nvim'
fi
# <<< EDITOR

# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# >>> NODE
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
# <<< NODE

# >>> ALIASES
alias cdp="cd ~/Programowanie/Projekty/"
# <<< ALIASES

# >>> LOAD EXTRA ZSH CONFIG
if [[ -d "$HOME/.zshrc.d" ]]; then
	for zsh_config in "$HOME"/.zshrc.d/*.zsh(N); do
		source "$zsh_config"
	done
	unset zsh_config
fi
# <<< LOAD EXTRA ZSH CONFIG

# >>> LM STUDIO
export PATH="$PATH:/home/grzegorz/.lmstudio/bin"
# <<< LM STUDIO

# >>> PATH
export PATH="$PATH:/home/grzegorz/.local/bin"
# <<< PATH

# >>> SSH
ssh-add ~/.ssh/id_github_ed25519 2>/dev/null
ssh-add ~/.ssh/id_github_grzegorzwitkowski_ed25519 2>/dev/null
# <<< SSH

# >>> TMUX
if [ -z "$TMUX" ]; then
  exec tmux
fi
# <<< TMUX

# >>> GIT
gitcl_gwtkwsk() { git clone "git@github.com_gwtkwsk:$1"; }
gitcl_grzegorzwitkowski() { git clone "git@github.com_grzegorzwitkowski:$1"; }
# <<< GIT

export LANG=en_GB.UTF-8

. "$HOME/.local/bin/env"
