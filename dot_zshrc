export ZSH_CUSTOM="$HOME/.zshrc.d"

# >>> OH-MY-ZSH
export ZSH="$HOME/.oh-my-zsh"
plugins=(git)
source $ZSH/oh-my-zsh.sh
# <<< OH-MY-ZSH

# >>> EDITOR
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vi'
else
  export EDITOR='nvim'
fi
# <<< EDITOR

# >>> NODE
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
# <<< NODE

# >>> LM STUDIO
export PATH="$PATH:/home/grzegorz/.lmstudio/bin"
# <<< LM STUDIO

# >>> PATH
export PATH="$PATH:/home/grzegorz/.local/bin:/home/grzegorz/bin"
# <<< PATH

# >>> SSH
ssh-add ~/.ssh/id_github_gwtkwsk_ed25519 2>/dev/null
ssh-add ~/.ssh/id_github_grzegorzwitkowski_ed25519 2>/dev/null
# <<< SSH

# >>> STARSHIP
eval "$(starship init zsh)"
# <<< STARSHIP

# >>> LANG
export LANG=en_GB.UTF-8
# <<< LANG

