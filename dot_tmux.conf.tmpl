{{- if not .theme -}}
{{ fail "Missing .theme in .chezmoidata.yaml. Copy .chezmoidata.yaml.example to .chezmoidata.yaml and set the local theme." }}
{{- end -}}
{{- $preset := index .themePresets .theme -}}
{{- if not $preset -}}
{{ fail (printf "Unsupported .theme value %q in .chezmoidata.yaml" .theme) }}
{{- end -}}
set-window-option -g mode-keys vi
set-window-option -g automatic-rename on
set-window-option -g automatic-rename-format "#{pane_current_command}"
set-window-option -g monitor-bell on
set -g mouse on
set -g history-limit 10000
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g status-position top
set -g bell-action any
set -g default-terminal "screen-256color"
# Tell tmux which terminal families support 24-bit color so it can pass RGB through to apps like Neovim.
set -g terminal-features[200] "xterm*:RGB"
set -g terminal-features[201] "screen*:RGB"
set -g terminal-features[202] "tmux*:RGB"
set -g terminal-features[203] "wezterm*:RGB"
set -g terminal-features[204] "ghostty*:RGB"

# Keys
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R

bind -r H resize-pane -L 10
bind -r J resize-pane -D 2
bind -r K resize-pane -U 2
bind -r L resize-pane -R 10

bind r source-file ~/.tmux.conf \; display "Config reloaded!"
bind C-l send-keys C-l \; clear-history
bind C command-prompt -p "Window name:" "new-window -c '#{pane_current_path}' -n '%%'"

bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin_interpolated_options 'status-right status-left'

{{ includeTemplate $preset.tmuxTemplate $preset }}

# TPM init
run '~/.tmux/plugins/tpm/tpm'
{{- if hasKey $preset "tmuxBellPalette" }}
{{- $tmuxBellPalette := index $preset "tmuxBellPalette" }}
{{- with $tmuxBellPalette }}
set -g window-status-current-format "#[bg={{ .yellow2 }},fg={{ .bg1 }},nobold,noitalics,nounderscore]#[bg={{ .yellow2 }},fg={{ .bg2 }}] #I #[bg={{ .yellow2 }},fg={{ .bg2 }},bold] #W#{?window_bell_flag, 󰅸,}#{?window_zoomed_flag,*Z,} #[bg={{ .bg1 }}]#[fg={{ .yellow2 }},nobold,noitalics,nounderscore]"
set -g window-status-format "#[bg={{ .bg2 }},fg={{ .bg1 }},noitalics]#[bg={{ .bg2 }},fg={{ .fg1 }}] #I #[bg={{ .bg2 }},fg={{ .fg1 }}] #W#{?window_bell_flag, 󰅸,} #[bg={{ .bg1 }}]#[fg={{ .bg2 }},noitalics]"
{{- end }}
{{- end }}
