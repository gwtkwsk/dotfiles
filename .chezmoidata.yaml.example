# Copy this file to `.chezmoidata.yaml` and adjust it per machine.
# `.chezmoidata.yaml` is intentionally gitignored.
#
# Allowed values for `theme`: `gruvbox-dark-medium`, `gruvbox-light-medium`,
# `catppuccin-frappe`, `catppuccin-latte`, `catppuccin-macchiato`,
# `catppuccin-mocha`.
theme: gruvbox-dark-medium

# Allowed values for `prompt_engine`: `powerlevel10k`, `starship`, `none`.
# `none` disables external prompt engines and uses the default Oh My Zsh theme.
prompt_engine: powerlevel10k

# Required per-machine Git identity used by `dot_gitconfig.tmpl`.
# git:
#   user:
#     name: Your Name
#     email: you@example.com

# Path used by the `cdp` alias to quickly jump to your projects directory.
# cdp_path: ~/Projects/

# Add other machine-specific values here as needed, for example:
# is_wsl: true
# windows_home: /mnt/c/Users/YourWindowsUser
# os: linux

# SSH config entries to apply on this machine. Each entry's name is used to
# derive the SSH host alias, clone helper alias, and private key path.
# ssh_keys:
#   - account_a
#   - name: account_b
#     identity_file: ~/.ssh/id_account_b_ed25519
#     host: github.com_account_b
#     hostname: github.com
#     user: git
#     clone_alias: gitcl_account_b
