{{- $promptEngine := "powerlevel10k" -}}
{{- if hasKey . "prompt_engine" -}}
  {{- if or (eq .prompt_engine "starship") (eq .prompt_engine "powerlevel10k") (eq .prompt_engine "none") -}}
    {{- $promptEngine = .prompt_engine -}}
  {{- else -}}
    {{- fail (printf "Unsupported .prompt_engine value %q in .chezmoidata.yaml" .prompt_engine) -}}
  {{- end -}}
{{- end -}}

{{- if eq $promptEngine "powerlevel10k" }}
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
{{- end }}

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.zshrc.d"

# Set to `starship`, `powerlevel10k`, or `none`.
export ZSH_PROMPT_ENGINE="${ZSH_PROMPT_ENGINE:-{{ $promptEngine }}}"

# >>> PROMPT
# Oh My Zsh reads ZSH_THEME during startup, so this must stay above `source $ZSH/oh-my-zsh.sh`.
POWERLEVEL10K_THEME_FILE=""
case "$ZSH_PROMPT_ENGINE" in
  powerlevel10k)
    if [[ -r "$ZSH_CUSTOM/themes/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
      ZSH_THEME="powerlevel10k/powerlevel10k"
    elif [[ -r "$ZSH/custom/themes/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
      ZSH_THEME=""
      POWERLEVEL10K_THEME_FILE="$ZSH/custom/themes/powerlevel10k/powerlevel10k.zsh-theme"
    else
      ZSH_THEME="robbyrussell"
    fi
    ;;
  starship)
    ZSH_THEME=""
    ;;
  none)
    ZSH_THEME="robbyrussell"
    ;;
  *)
    ZSH_THEME="robbyrussell"
    ;;
esac
# <<< PROMPT

# >>> OH-MY-ZSH
# Keep Oh My Zsh for plugin loading (`plugins=(git)`) and auto-loading files from `$ZSH_CUSTOM`.
# `zsh-syntax-highlighting` must be the last plugin so it can wrap all other widgets.
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)
source $ZSH/oh-my-zsh.sh
[[ -n "$POWERLEVEL10K_THEME_FILE" ]] && source "$POWERLEVEL10K_THEME_FILE"
unset POWERLEVEL10K_THEME_FILE
# <<< OH-MY-ZSH

# >>> EDITOR
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vi'
else
  export EDITOR='nvim'
fi
# <<< EDITOR

# >>> LM STUDIO
export PATH="$PATH:$HOME/.lmstudio/bin"
# <<< LM STUDIO

# >>> PATH
export PATH="$PATH:$HOME/.local/bin:$HOME/bin:$HOME/.cargo/bin:$HOME/.opencode/bin"
# <<< PATH

# >>> SSH
{{- $sshKeys := get . "ssh_keys" | default list }}
{{- if gt (len $sshKeys) 0 }}
ssh_keys=(
{{- range $key := $sshKeys }}
{{- $name := "" -}}
{{- $identityFile := "" -}}
{{- if kindIs "string" $key -}}
{{- $name = $key -}}
{{- else -}}
{{- $name = get $key "name" -}}
{{- $identityFile = get $key "identity_file" -}}
{{- end -}}
{{- if eq $name "" }}{{ fail "ssh_keys entries must set name" }}{{ end -}}
{{- $safeName := $name | replace "-" "_" | replace "." "_" -}}
{{- $identityFile = $identityFile | default (printf "~/.ssh/id_%s_ed25519" $safeName) -}}
{{ printf "\n  \"%s\"" ($identityFile | replace "~/" "$HOME/") -}}
{{- end }}
)
for ssh_key in "${ssh_keys[@]}"; do
  [[ -f "$ssh_key" ]] && ssh-add "$ssh_key" 2>/dev/null
done
unset ssh_keys
{{- end }}
# <<< SSH

# >>> PROMPT
case "$ZSH_PROMPT_ENGINE" in
  starship)
    if command -v starship >/dev/null 2>&1; then
      eval "$(starship init zsh)"
    fi
    ;;
  powerlevel10k)
    [[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
    ;;
esac
# <<< PROMPT

# >>> LANG
export LANG=en_GB.UTF-8
# <<< LANG

# >>> ZOXIDE
eval "$(zoxide init zsh)"
# <<< ZOXIDE

# >>> FZF
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi
# <<< FZF

# >>> WORKTRUNK
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
# <<< WORKTRUNK

# >>> HISTORY
HISTFILE="$HOME/.zhistory"
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# Completion using arrow keys based on history.
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
# <<< HISTORY

# >>> FNM
FNM_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --shell zsh)"
fi
# <<< FNM
