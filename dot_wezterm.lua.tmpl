{{- if not .theme -}}
{{ fail "Missing .theme in .chezmoidata.yaml. Copy .chezmoidata.yaml.example to .chezmoidata.yaml and set the local theme." }}
{{- end -}}
{{- $preset := index .themePresets .theme -}}
{{- if not $preset -}}
{{ fail (printf "Unsupported .theme value %q in .chezmoidata.yaml" .theme) }}
{{- end -}}
local wezterm = require("wezterm")
local config = wezterm.config_builder()

{{- if get . "is_wsl" }}
config.default_domain = "WSL:FedoraLinux-44"
{{- end }}

config.initial_cols = 160
config.initial_rows = 40

config.font = wezterm.font("JetBrainsMono Nerd Font")
config.font_size = 10
config.color_scheme = "{{ $preset.weztermColorScheme }}"
config.window_background_opacity = 0.95

config.enable_tab_bar = false
{{- if eq .chezmoi.os "darwin" }}
config.window_decorations = "RESIZE"
{{- end }}

return config
