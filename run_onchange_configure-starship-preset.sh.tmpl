#!/bin/sh
set -eu

if ! command -v starship >/dev/null 2>&1; then
  echo "starship is not installed; skipping starship preset generation" >&2
  exit 0
fi

mkdir -p "$HOME/.config"

{{- if eq .theme "gruvbox" }}
starship preset gruvbox-rainbow -o "$HOME/.config/starship.toml"
{{- else if eq .theme "catppuccin" }}
starship preset catppuccin-powerline -o "$HOME/.config/starship.toml"
{{- else }}
echo "Unsupported .theme value: {{ .theme }}" >&2
exit 1
{{- end }}
