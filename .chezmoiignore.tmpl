chezmoi-apply-fast.sh
{{- if not (get . "is_wsl") }}
.zshrc.d/gnome-keyring.zsh
{{- end }}

{{- $sshKeys := get . "ssh_keys" | default list }}
{{- if eq (len $sshKeys) 0 }}{{ fail "ssh_keys must be set in .chezmoidata.yaml" }}{{- end }}
{{- if not (has "gwtkwsk" $sshKeys) }}
.ssh/id_github_gwtkwsk_ed25519
.ssh/id_github_gwtkwsk_ed25519.pub
{{- end }}
{{- if not (has "grzegorzwitkowski" $sshKeys) }}
.ssh/id_github_grzegorzwitkowski_ed25519
.ssh/id_github_grzegorzwitkowski_ed25519.pub
{{- end }}
