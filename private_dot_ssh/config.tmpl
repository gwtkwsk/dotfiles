{{- $sshKeys := get . "ssh_keys" | default list -}}
{{- if has "gwtkwsk" $sshKeys }}
Host github.com_gwtkwsk
    Hostname github.com
    User gwtkwsk
    IdentityFile ~/.ssh/id_github_gwtkwsk_ed25519
    IdentitiesOnly yes
    AddKeysToAgent yes

{{- end }}
{{- if has "grzegorzwitkowski" $sshKeys }}
Host github.com_grzegorzwitkowski
    Hostname github.com
    User grzegorzwitkowski
    IdentityFile ~/.ssh/id_github_grzegorzwitkowski_ed25519
    IdentitiesOnly yes
    AddKeysToAgent yes

{{- end }}
